    menu "Tests Configuration"
        
        config MAIA_TEST_ENABLE
            bool "Enable test mode (disable MAIA App)"
            default n
            help
                Enable one of the available hardware tests below.
                When enabled, the selected test runs instead of the main app.

        choice MAIA_TEST_SELECT
            prompt "Select test to run"
            depends on MAIA_TEST_ENABLE
            default MAIA_TEST_BLINK
            help
                Choose which test to run when test mode is enabled.

            config MAIA_TEST_BLINK
                bool "LED Blink Test"
                help
                    Simple LED blink test for hardware validation.
            
            config MAIA_TEST_BUTTON
                bool "Button Driver Test"
                help
                    Test button driver with all events:
                    - PRESSED/RELEASED
                    - SINGLE_CLICK/DOUBLE_CLICK
                    - LONG_PRESS
                    - EXTRA_LONG_PRESS_1/2

            config MAIA_TEST_TEMPERATURE_SENSOR
                bool "Temperature Sensor (DS18B20)"
                depends on MAIA_DS18B20_ENABLE
                help
                    Test DS18B20 OneWire temperature sensor:
                    - Blocking read mode
                    - Async read mode (trigger + scratchpad)
                    - CRC verification
                    - Unit conversion (Celsius/Fahrenheit/Kelvin)

            config MAIA_TEST_HAPTIC_MOTOR
                bool "Haptic Motor (DRV2605L)"
                depends on MAIA_DRV2605L_ENABLE
                help
                    Test DRV2605L haptic motor driver:
                    - Library effects playback (1-123)
                    - Effect sequencing
                    - Auto-calibration
                    - RTP mode (if composer enabled)
                    - Device status monitoring

            config MAIA_TEST_DISPLAY
                bool "OLED Display (SSD1306)"
                depends on MAIA_SSD1306_ENABLE
                help
                    Test SSD1306 OLED display driver:
                    - Display initialization
                    - Framebuffer rendering
                    - Text output (small and large fonts)
                    - Screen on/off (power management)
                    - Contrast adjustment
                    - Pixel drawing

            config MAIA_TEST_IMU
                bool "IMU (MPU6050)"
                depends on MAIA_IMU_MPU6050
                help
                    Test MPU-6050 IMU driver:
                    - WHO_AM_I identification
                    - Factory self-test
                    - Raw and scaled accel/gyro reads
                    - Gyro bias calibration
                    - Runtime range switching
                    - Sleep / wakeup power management
                    - DMP quaternion output
                    - Quaternion to Euler angles

            config MAIA_TEST_TOF
                bool "ToF Sensor (VL53L5CX)"
                depends on MAIA_VL53L5CX_ENABLE
                help
                    Test VL53L5CX ToF sensor driver. See
                    MAIA_TEST_TOF_MODE below for which
                    sub-test runs.

            config MAIA_TEST_WIFI
                bool "WiFi Radio Driver"
                depends on MAIA_WIFI_ENABLE
                help
                    Test the WiFi radio driver (L1-L4: core, station,
                    diagnostic AP, scan). See MAIA_TEST_WIFI_MODE below
                    for which sub-test runs. Does not exercise the
                    provisioning setup flow — that service does not
                    exist yet (spec/wifi_subsystem.md).

            config MAIA_TEST_LIDAR_VIEWER
                bool "LiDAR 3D Web Viewer (Pin Art)"
                depends on MAIA_VL53L5CX_ENABLE && MAIA_WIFI_ENABLE
                help
                    Starts ranging on the enabled VL53L5CX sensor(s)
                    and serves a local web page rendering each frame
                    as a "Pin Art" grid: one pin per zone, pushed out
                    proportionally to how close its target is. Open
                    the IP printed on the serial log in any browser on
                    the same network. Runs until reset.

                    Getting WiFi up follows the WiFi operating mode
                    selected above (MAIA_WIFI_MODE, under WiFi
                    Configuration): AP mode raises the plain
                    diagnostic AP — join it directly from a browser,
                    no pairing app, unaffected by any WiFi credentials
                    already stored in NVS — the simplest choice for a
                    quick bench test. Every other mode goes through
                    wifi_prov_service_run(), which needs the ESP
                    SoftAP Prov app the first time (or stored
                    credentials for a network actually in range).
        endchoice

        choice MAIA_TEST_TOF_MODE
            prompt "ToF test mode"
            depends on MAIA_TEST_TOF
            default MAIA_TEST_TOF_MODE_SUITE
            help
                Which VL53L5CX test to run when the ToF
                Sensor test is selected above.

            config MAIA_TEST_TOF_MODE_SUITE
                bool "Basic test suite"
                help
                    - Single sensor init
                    - Firmware upload verification
                    - Device ID check (is_alive)
                    - Single ranging read (poll, 1 frame)
                    - Zone data validity (status filtering)
                    - Distance plausibility
                    - Resolution set/get
                    - Power mode (sleep/wake/read)

            config MAIA_TEST_TOF_MODE_LIVE
                bool "Live distance stream"
                help
                    Init the sensor, start ranging, and
                    continuously print the closest valid
                    distance so you can see it change as
                    you move an object toward/away from
                    the sensor. Runs until reset.

            config MAIA_TEST_TOF_MODE_MATRIX
                bool "Live matrix view on OLED"
                depends on MAIA_SSD1306_ENABLE
                help
                    Render the full zone grid live on the
                    SSD1306 as a proximity heat map: the
                    denser a cell, the closer the target
                    in that zone. Shows what the sensor
                    sees spatially rather than a single
                    number. Requires the OLED display.
                    Runs until reset.

            config MAIA_TEST_TOF_MODE_PRESENCE
                bool "Object presence LED indicator"
                help
                    Init the sensor, start ranging, and
                    drive the status LED (the same one
                    used by the blink test) high while
                    any zone reports a valid target,
                    low otherwise. Any zone that survives
                    the existing status/signal filters
                    counts as "detected" — i.e. the
                    farthest target the current Kconfig
                    (integration time, resolution, signal
                    threshold, etc.) can reliably report.
                    Runs until reset.
        endchoice

        menu "WiFi Test Configuration"
            depends on MAIA_TEST_WIFI

            choice MAIA_TEST_WIFI_MODE
                prompt "WiFi test mode"
                default MAIA_TEST_WIFI_MODE_SUITE
                help
                    Which WiFi driver test to run when the WiFi Radio
                    Driver test is selected above.

                config MAIA_TEST_WIFI_MODE_SUITE
                    bool "Basic test suite"
                    help
                        - init/deinit
                        - MAC suffix formatting
                        - is_provisioned() against esp_wifi's stored config
                        - State transitions with no radio activity

                config MAIA_TEST_WIFI_MODE_SCAN
                    bool "Network scan"
                    help
                        Scan and print visible networks with SSID, RSSI,
                        channel and auth mode. Also the fastest way to
                        sanity-check the antenna is connected — see the
                        WROOM-1U note under MAIA_WIFI_AP_SSID_PREFIX.

                config MAIA_TEST_WIFI_MODE_CONNECT
                    bool "Exercise connectivity (per WiFi operating mode)"
                    help
                        Runs whatever MAIA_WIFI_MODE above selects, entirely
                        from code outside the driver — this is where the
                        reconnect policy (retry count, exponential backoff,
                        giving up) and the boot decision live today, since
                        the driver itself only exposes primitives and raw
                        events (see the SCOPE note in maia_wifi.h). An
                        app/service will take over this same role later
                        without the driver changing.

                        Auto    - is_provisioned() -> connect; else Kconfig
                                  seed -> connect; else raise the diagnostic
                                  AP. Applies the reconnect policy once
                                  connecting.
                        Station - connect using MAIA_WIFI_STA_SSID/PASSWORD
                                  only, same reconnect policy, never falls
                                  back to the AP.
                        AP      - raise the diagnostic AP only, log
                                  client join/leave events, run until reset.
            endchoice

            config MAIA_TEST_WIFI_LED_FEEDBACK
                bool "Blink status LED to reflect WiFi state"
                default y
                depends on MAIA_TEST_WIFI_MODE_CONNECT
                help
                    Runs led_feedback_task() alongside the connectivity
                    test, driving the status LED per
                    MAIA_LED_BLINK_FREQ_AP_HZ / _STA_HZ (see "Status
                    indication" under WiFi Configuration): blinking while
                    raising the AP or connecting, solid once connected,
                    off otherwise.

                    Disable to isolate whether an LED-related symptom
                    comes from the blink task itself, or if the status
                    LED is not the GPIO you expect on this board revision
                    (see MAIA_LED_STATUS_GPIO under LEDs Configuration).
        endmenu

        menu "LiDAR Web Viewer Configuration"
            depends on MAIA_TEST_LIDAR_VIEWER

            config MAIA_LIDAR_VIEWER_HTTP_PORT
                int "HTTP server port"
                default 80
                range 1 65535
                help
                    Port the Pin Art viewer's built-in HTTP server
                    listens on.

            config MAIA_LIDAR_VIEWER_DEFAULT_MAX_MM
                int "Default max range shown (mm)"
                default 2000
                range 100 4000
                help
                    Initial distance that maps to a fully-retracted
                    pin (height 0) in the web page. This is only the
                    starting value — the page has a live slider to
                    change it without reflashing, since the right
                    range depends on what you're pointing the sensor
                    at. Zones beyond this range, and zones filtered
                    out by the driver (no valid target), are both
                    rendered as flat grey pins so neither is mistaken
                    for "close" — see the tooltip on each pin for the
                    exact raw mm reading and status.
        endmenu

    endmenu

endmenu
