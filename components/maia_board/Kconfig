                    config MAIA_SSD1306_DEFAULT_PAGE
                        int "Default page on boot"
                        default 0
                        range 0 9
                        help
                            Which page to display after driver init.
                            Must be less than MAIA_SSD1306_NUM_PAGES.

                endmenu
            endmenu

            menu "IMU"
                config MAIA_IMU_ENABLE
                    bool "Enable IMU"
                    default y
                    help
                        Enable Inertial Measurement Unit driver.
 
                choice MAIA_IMU_DEVICE
                    prompt "IMU device"
                    depends on MAIA_IMU_ENABLE
                    default MAIA_IMU_MPU6050
                    help
                        Select the IMU device connected to the I2C bus.
 
                    config MAIA_IMU_MPU6050
                        bool "MPU-6050 (InvenSense, accel+gyro+DMP)"
                        help
                            6-axis IMU with integrated Digital Motion
                            Processor. Provides raw accel/gyro and
                            quaternion output via DMP firmware.
 
                    config MAIA_IMU_ADXL345
                        bool "ADXL345 (Analog Devices, accel only)"
                        help
                            3-axis accelerometer only. No gyroscope,
                            no DMP. Use when gyro is not required.

                    config MAIA_IMU_LSM6DSOX
                        bool "LSM6DSOX (ST, accel+gyro+MLC/FSM)"
                        help
                            6-axis iNEMO module with Machine Learning
                            Core, Finite State Machine, pedometer and
                            a 9 kB tagged FIFO. No DMP-style
                            quaternion output.
