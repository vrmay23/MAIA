                config MAIA_VL53L5CX_FILTER_STATUS_5
                    bool "Filter target status 5 (Threshold fail)"
                    default y
                    depends on MAIA_VL53L5CX_ENABLE
                    help
                        Filter false positives in bright sunlight.

                config MAIA_VL53L5CX_FILTER_STATUS_6
                    bool "Filter target status 6 (Signal fail)"
                    default y
                    depends on MAIA_VL53L5CX_ENABLE
                    help
                        Filter invalid readings with no return signal.

                choice MAIA_VL53L5CX_MODE
                    prompt "Sensor mode"
                    default MAIA_VL53L5CX_MODE_DUAL
                    depends on MAIA_VL53L5CX_ENABLE
                    help
                        Select which physical VL53L5CX sensor(s) to
                        bring up. Use one of the single-sensor modes
                        if one unit is known bad (e.g. a solder
                        defect) while the other works fine — this
                        does not require any source change, only
                        reconfiguring which physical GPIOs/address
                        the driver's primary sensor slot uses.

                    config MAIA_VL53L5CX_MODE_DUAL
                        bool "Dual sensor (left + right)"

                    config MAIA_VL53L5CX_MODE_LEFT_ONLY
                        bool "Single sensor - left only"

                    config MAIA_VL53L5CX_MODE_RIGHT_ONLY
                        bool "Single sensor - right only"
                endchoice

                config MAIA_VL53L5CX_RANGING_FREQ_HZ
                    int "Ranging frequency (Hz)"
                    default 10
                    range 1 60
                    depends on MAIA_VL53L5CX_ENABLE
                    help
                        Measurement frequency. Higher values use more
                        power. Max 60Hz at 4x4, 15Hz at 8x8.

                choice MAIA_VL53L5CX_RESOLUTION
                    prompt "Resolution"
                    default MAIA_VL53L5CX_RESOLUTION_8X8
                    depends on MAIA_VL53L5CX_ENABLE
                    help
                        Number of ranging zones.

                    config MAIA_VL53L5CX_RESOLUTION_4X4
                        bool "4x4 (16 zones, up to 60Hz)"

                    config MAIA_VL53L5CX_RESOLUTION_8X8
                        bool "8x8 (64 zones, up to 15Hz)"
                endchoice

                config MAIA_VL53L5CX_INTEGRATION_TIME_MS
                    int "Integration time (ms)"
                    default 5
                    range 5 1000
                    depends on MAIA_VL53L5CX_ENABLE
                    help
                        VCSEL integration time per measurement.
                        Only relevant in autonomous ranging mode.
                        Lower values save power but reduce range.

                choice MAIA_VL53L5CX_RANGING_MODE
                    prompt "Ranging mode"
                    default MAIA_VL53L5CX_RANGING_MODE_AUTONOMOUS
                    depends on MAIA_VL53L5CX_ENABLE
                    help
                        Continuous: VCSEL always on, best range.
                        Autonomous: VCSEL pulsed, lower power.

                    config MAIA_VL53L5CX_RANGING_MODE_CONTINUOUS
                        bool "Continuous (max range, high power)"

                    config MAIA_VL53L5CX_RANGING_MODE_AUTONOMOUS
                        bool "Autonomous (lower power, default)"
                endchoice

                config MAIA_VL53L5CX_MIN_SIGNAL_PER_SPAD
