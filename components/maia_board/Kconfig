    menu "Tests Configuration"
        
        config MAIA_TEST_ENABLE
            bool "Enable test mode (disable MAIA App)"
            default n
            help
                Enable one of the available hardware tests below.
                When enabled, the selected test runs instead of the main app.

        choice MAIA_TEST_SELECT
            prompt "Select test to run"
            depends on MAIA_TEST_ENABLE
            default MAIA_TEST_BLINK
            help
                Choose which test to run when test mode is enabled.

            config MAIA_TEST_BLINK
                bool "LED Blink Test"
                help
                    Simple LED blink test for hardware validation.
            
            config MAIA_TEST_BUTTON
                bool "Button Driver Test"
                help
                    Test button driver with all events:
                    - PRESSED/RELEASED
                    - SINGLE_CLICK/DOUBLE_CLICK
                    - LONG_PRESS
                    - EXTRA_LONG_PRESS_1/2

            config MAIA_TEST_TEMPERATURE_SENSOR
                bool "Temperature Sensor (DS18B20)"
                help
                    Test DS18B20 OneWire temperature sensor:
                    - Blocking read mode
                    - Async read mode (trigger + scratchpad)
                    - CRC verification
                    - Unit conversion (Celsius/Fahrenheit/Kelvin)

            config MAIA_TEST_HAPTIC_MOTOR
                bool "Haptic Motor (DRV2605L)"
                help
                    Test DRV2605L haptic motor driver:
                    - Library effects playback (1-123)
                    - Effect sequencing
                    - Auto-calibration
                    - RTP mode (if composer enabled)
                    - Device status monitoring

            config MAIA_TEST_DISPLAY
                bool "OLED Display (SSD1306)"
                help
                    Test SSD1306 OLED display driver:
                    - Display initialization
                    - Framebuffer rendering
                    - Text output (small and large fonts)
                    - Screen on/off (power management)
                    - Contrast adjustment
                    - Pixel drawing

            config MAIA_TEST_IMU
                bool "IMU (MPU6050)"
                help
                    Test MPU-6050 IMU driver:
                    - WHO_AM_I identification
                    - Factory self-test
                    - Raw and scaled accel/gyro reads
                    - Gyro bias calibration
                    - Runtime range switching
                    - Sleep / wakeup power management
                    - DMP quaternion output
                    - Quaternion to Euler angles

            config MAIA_TEST_TOF
                bool "ToF Sensor (VL53L5CX)"
                help
                    Test VL53L5CX ToF sensor driver. See
                    MAIA_TEST_TOF_MODE below for which
                    sub-test runs.
        endchoice

        choice MAIA_TEST_TOF_MODE
            prompt "ToF test mode"
            depends on MAIA_TEST_TOF
            default MAIA_TEST_TOF_MODE_SUITE
            help
                Which VL53L5CX test to run when the ToF
                Sensor test is selected above.

            config MAIA_TEST_TOF_MODE_SUITE
                bool "Basic test suite"
                help
                    - Single sensor init
                    - Firmware upload verification
                    - Device ID check (is_alive)
                    - Single ranging read (poll, 1 frame)
                    - Zone data validity (status filtering)
                    - Distance plausibility
                    - Resolution set/get
                    - Power mode (sleep/wake/read)

            config MAIA_TEST_TOF_MODE_LIVE
                bool "Live distance stream"
                help
                    Init the sensor, start ranging, and
                    continuously print the closest valid
                    distance so you can see it change as
                    you move an object toward/away from
                    the sensor. Runs until reset.

            config MAIA_TEST_TOF_MODE_MATRIX
                bool "Live matrix view on OLED"
                help
                    Render the full zone grid live on the
                    SSD1306 as a proximity heat map: the
                    denser a cell, the closer the target
                    in that zone. Shows what the sensor
                    sees spatially rather than a single
                    number. Requires the OLED display.
                    Runs until reset.
        endchoice

    endmenu

endmenu
